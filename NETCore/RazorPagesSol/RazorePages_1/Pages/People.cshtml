@page
@model RazorePages_1.Pages.PeopleModel
@{
    <h1>People</h1>
        
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.People)
            {
                <tr>
                    <th>@item.Id</th>
                    <th>@item.Name</th>
                    <th>@item.Age</th>
                </tr>
            }
        </tbody>
    </table>
}
