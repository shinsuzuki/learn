@page
@model RazorePages_1.Pages.PeopleModel
@{
    <h1>People</h1>
        
    <table class="table table-bordered table-sm m-0 align-middle">
        <thead class="table-light text-nowrap text-center">
            <tr>
                <th class="" style="width: 50px;">選択</th>
                <th class="">ID</th>
                <th class="">Name</th>
                <th class="">Age</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.People)
            {
                <tr x-data="{ selected: false }" :class="{ 'table-active': selected }">
                    <td class="text-center">
                        <!-- チェックボックスと selected 変数を連動 -->
                        <input type="checkbox"
                               class="form-check-input"
                               x-model="selected"
                               name="selectedIds"
                               value="@item.Id" />
                    </td>

                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                </tr>
            }
        </tbody>
    </table>
}
